{
  "name": "fastify-recaptcha",
  "version": "1.0.0",
  "description": "Fastify plugin for Google reCAPTCHA v2 and v3 verification",
  "keywords": [
    "captcha",
    "fastify",
    "google",
    "middleware",
    "plugin",
    "recaptcha",
    "security",
    "validation",
    "verification"
  ],
  "homepage": "https://github.com/isildakfikret/fastify-recaptcha#readme",
  "bugs": {
    "url": "https://github.com/isildakfikret/fastify-recaptcha/issues"
  },
  "license": "MIT",
  "author": "Fikret ISILDAK <isildakfikret@gmail.com>",
  "contributors": [
    {
      "name": "Fikret ISILDAK",
      "email": "isildakfikret@gmail.com",
      "url": "https://github.com/isildakfikret"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/isildakfikret/fastify-recaptcha.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/isildakfikret"
  },
  "files": [
    "dist"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:cjs && pnpm run build:esm && pnpm run build:types && pnpm run build:meta",
    "build:cjs": "swc src -d dist/cjs --config-file .swcrc.cjs.json --strip-leading-paths",
    "build:esm": "swc src -d dist/esm --config-file .swcrc.esm.json --strip-leading-paths",
    "build:types": "tsc -p tsconfig.build.json",
    "build:meta": "node -e \"const f=require('node:fs');f.writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n');f.writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "watch": "swc src -d dist/cjs --config-file .swcrc.cjs.json --strip-leading-paths --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish"
  },
  "dependencies": {
    "fastify-plugin": "^6.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "fastify": "^5.12.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "fastify": "^5.12.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
